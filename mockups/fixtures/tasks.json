    {
      "id": "tsk_01K6S2M4QF", "kind": "github", "num": "a-intel/platform#612", "repo": "a-intel/platform",
      "subject": "Rate limiter returns 500 instead of 429 when the key bucket is empty",
      "body": "POST /v1/keys returns 500 once a key's bucket is empty. The limiter throws RateLimitExhausted and nothing maps it, so the client sees an internal error and retries at once.\n\nSteps: create a key with a 5 per minute limit, send 6 requests in 10 seconds. The sixth returns 500.\n\nExpected: 429 with Retry-After.",
      "labels": ["p1", "bug"], "owner": "gh:mbell-ai", "createdBy": "gh:vk-dev", "createdAt": "2026-09-08 10:14", "updatedBy": "gh:mbell-ai", "updatedAt": "2026-09-10 16:02", "closedAt": null,
      "status": "open", "resolution": null, "ready": "ready", "certifiedBy": "marcus", "certifiedAt": "2026-09-10 16:05", "digest": "sha256:61c0a9e24d7f18b3",
      "dod": [
        { "t": "POST /v1/keys returns 429 with a Retry-After header when the bucket is empty", "k": "check", "tag": "code", "src": "issue" },
        { "t": "A unit test sends six requests against a five-per-minute key and asserts the sixth is 429", "k": "check", "tag": "test", "src": "assistant" },
        { "t": "No other route that uses the limiter returns 500 for an exhausted bucket", "k": "check", "tag": "code", "src": "assistant" },
        { "t": "The API reference for rate limits names the 429 response and its header", "k": "check", "tag": "docs", "src": "operator" },
        { "t": "A reviewer confirms the error mapping lives in the central onError handler", "k": "review", "tag": "review", "src": "assistant" }
      ],
      "notes": ["The issue gives a reproduction and an expected result. Nothing is missing."]
    },
