   { "n": "list_disputes", "d": "List open disputes and their evidence deadlines.", "risk": "low", "eff": "read", "out": true, "fin": "none" },
   { "n": "cancel_payment_intent", "d": "Cancel a payment intent that has not captured.", "risk": "high", "eff": "irreversible", "out": false, "fin": "spend" }
  ]
